# PROVISIONAL placeholders for the fastlane lanes (ADR 0016). Copy this file to a local, gitignored env file.
# Create the API key in App Store Connect > Users and Access > Integrations > App Store Connect API
# (https://appstoreconnect.apple.com/access/integrations/api). Never commit the .p8 file or real values.
# Export the values in your shell before `bundle exec fastlane mac build`.
APP_STORE_CONNECT_API_KEY_ID=ABC123DEFG
APP_STORE_CONNECT_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8
